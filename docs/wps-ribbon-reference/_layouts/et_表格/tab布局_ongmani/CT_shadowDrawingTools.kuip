<?xml version='1.0' encoding='UTF-8'?>
<shell component="et" tc="ongmani.ct_shadowdrawingtools" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxStaticGalleryItemCommand forceLine="true" galleryItemHeight="24" galleryItemWidth="108" id="NoShadow" ksoCmd="NoShadow" text="@No Shadow"/>
