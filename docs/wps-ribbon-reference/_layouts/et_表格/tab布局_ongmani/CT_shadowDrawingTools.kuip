		<KxEtShadowThemeCommand customTip2="ShadowColor2" customTip="ShadowColor" icon="shadow_color_kd" id="rShadowColor" ksoCmd="ShadowColor" ksoTriggerCmd="RecentShadowColor" rbHotKey="SC" text="@Shadow Color">
