		<KxLegacyTriggerCommand customTip="NudgeShadowUp" icon="shadow_up_kd" id="rNudgeShadowUp" ksoCmd="NudgeShadowUp" rbHotKey="1" spaceHint="compact" text="@Nudge Shadow Up"/>
