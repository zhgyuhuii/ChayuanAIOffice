		<KxEtProtectEyesCommand aid="100034" customTip="Protect_Eyes" dynamicSpaceHint="loose;suitable" filterFlag="1" hotKey="b" icon="eye_kd" id="ProtectEyesInViewTab" needLogin="false" qtspyName="ProtectEyes" rbHotKey="PE" text="@Eye Protection"/>
		<KxEtProtectEyesCommand aid="100034" customTip="Protect_Eyes" dynamicSpaceHint="loose;suitable" filterFlag="1" hotKey="b" icon="eye_kd" id="ProtectEyesInViewTab" qtspyName="ProtectEyes" rbHotKey="PE" text="@Eye Protection"/>
		<KListCommand groupTip="WorkbookViewGroup" icon="sheet_normal_kd" id="RB_Workbook_View" rbFileMenuEmbed="1" text="@Workbook Views">
			<command idQ="Normal"/>
			<KxLegacyTriggerCommand aid="724" customTip="PageBreakPreview" filterFlag="1" hotKey="p" icon="page_break_preview_kd" id="PageBreakPreviewInViewTab" ksoCmd="PageBreakPreview" qtspyName="PageBreakPreview" rbHotKey="I" text="@Page Break &#10;Preview"/>
			<command idQ="ProtectEyesInViewTab"/>
			<command idQ="ReadingLayoutAndColor"/>
			<KxLegacyTriggerCommand aid="178" controlType="6" customTip="FullScreenMode" filterFlag="1" hotKey="u" icon="screen_full_kd" id="RB_FullScreenModeOnMenu" idMso="ViewFullScreenView" ksoCmd="FullScreenModeOnMenu" spaceHint="autoconsize" text="@Full &#10;Screen"/>
		</KListCommand>
		<KListCommand groupTip="ShowGroup" icon="window_vert_review_left_kd" id="RB_WorksheetOptions" rbFileMenuEmbed="1" text="@Show">
			<KxLegacyTriggerCommand canHideText="0" controlType="6" customTip="DisplayRightToLeft" filter="lang=ar_SA" filterFlag="1" icon="worksheet_left_right_kd" id="ViewSheetRightToLeft" idMso="SheetRightToLeft" ksoCmd="DisplayRightToLeft" qtspyName="DisplayRightToLeft" rbHotKey="SR" text="@Sheet Right-to-Left"/>
			<KxSingleRowMergeGroupCommand customTip="ShowGroup" icon="window_vert_review_left_kd" id="SingleRow_WorksheetOptions" text="@Show"/>
			<KxCheckBoxCommand controlType="1" customTip="EditCloumns" filterFlag="1" hotKey="k" id="ViewFormulaBar" idMso="ViewFormulaBar" ksoCmd="FormulaBar" qtspyName="FormulaBar" rbHotKey="K" singlerowmergegroup="SingleRow_WorksheetOptions" spaceHint="suitable" text="@Formula Bar"/>
			<KxCheckBoxCommand controlType="1" customTip="DisplayGridlines" filterFlag="1" id="GridlinesExcel" idMso="GridlinesExcel" ksoCmd="FTB_GridSwitch" qtspyName="FTB_GridSwitch" rbHotKey="SG" singlerowmergegroup="SingleRow_WorksheetOptions" spaceHint="suitable" text="@Gridlines"/>
			<KxCheckBoxCommand controlType="1" customTip="DisplayHeadings" filterFlag="1" id="ViewHeadings" idMso="ViewHeadings" ksoCmd="DisplayHeadings" qtspyName="DisplayHeadings" rbHotKey="DH" singlerowmergegroup="SingleRow_WorksheetOptions" spaceHint="suitable" text="@Headings"/>
			<KxTaskPaneCheckBoxCommand customTip="TaskWindow" hotKey="k" id="ShowOrHideTaskPane" ksoCmd="TaskPane" qtspyName="TaskPane" rbHotKey="K" singlerowmergegroup="SingleRow_WorksheetOptions" spaceHint="suitable" text="@Task Window"/>
