			<KxLegacyTriggerCommand controlType="0" customTip="Zoom" filterFlag="1" hotKey="z" icon="screen_zoom_kd" id="ZoomDialog" idMso="ZoomDialog" ksoCmd="Zoom" needLogin="false" qtspyName="Zoom" rbHotKey="Q" singlerowmergegroup="SingleRow_Zoom" text="@Zoom"/>
			<KxEtFixedValueZoomCommand customTip="Zoom" filterFlag="1" hotKey="r" icon="screen_actual_size_kd" id="ZoomFixed100" needLogin="false" qtspyName="ZoomFixed100" rbHotKey="R" singlerowmergegroup="SingleRow_Zoom" text="100%"/>
