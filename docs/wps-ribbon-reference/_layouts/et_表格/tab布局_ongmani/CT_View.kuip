		<KComposeListCommand controlType="0" customTip="SwitchWindow" icon="window_switch_kd" id="rSwitchWindow" idMso="WindowSwitchWindowsMenuExcel" rbHotKey="W" spaceHint="suitable" text="@Switch Windows">
			<compose idQ="CurrentFileListInView"/>
			<KxShowMoreWindowCommand dialogHint="1" hotKey="M" qtspyName="MoreWindows" text="@More Windows"/>
