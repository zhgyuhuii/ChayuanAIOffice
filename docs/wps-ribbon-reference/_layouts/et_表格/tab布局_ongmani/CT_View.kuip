		<KxEtResetPositionSideBySideCommand customTip="VerbSideBySide" icon="reset_position_kd" id="rResetPositionSideBySide" idKey="CommonWindowArrangeAllAndCompare" rbHotKey="T" spaceHint="suitable" text="@Reset Window Position"/>
		<KxEtDbViewCommand controlType="0" customTip="DbFormView" filterFlag="1" icon="form_tick_kd" id="DbFormView" ksoCmd="DbFormView" linkName="DBSheetHelp" linkText="@Feature Introduction" text="@DB Form View"/>
		<KxEtDbViewCommand controlType="0" customTip="DbGanttView" filterFlag="1" icon="sheet_gantt_kd" id="DbGantView" ksoCmd="DbGanttView" linkName="DBSheetHelp" linkText="@Feature Introduction" text="@DB Gantt View"/>
		<KListCommand canHideText="0" customTip="FreezePanes" filterFlag="1" icon="cell_freeze_kd" id="rFreezeOptionsInView" rbHotKey="F" text="@Freeze Panes">
			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="a" icon="unfreeze_panes_kd" id="rUnfreeze" ksoCmd="UnFreezePanes" text="@Unfreeze Panes"/>
