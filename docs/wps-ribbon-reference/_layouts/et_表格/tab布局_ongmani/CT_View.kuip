			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="f" icon="cell_freeze_kd" id="rFreeze" ksoCmd="FreezePanes" text="@Freeze Panes"/>
			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="f" icon="cell_freeze_kd" id="rFreezePlus" ksoCmd="FreezePanesPlus" text="@Freeze Panes"/>
