			<command filter="support:ShieldMode=false" idQ="rWindowReset"/>
			<command idQ="rSplitPanes"/>
			<command filter="support:ShieldMode=false" idQ="rNewWindow" singlerowfold="1"/>
			<command idQ="rUnhideWindow" singlerowfold="1"/>
			<command idQ="rCmpSideBySide"/>
			<command idQ="rSyncScrollSideBySide" singlerowfold="1"/>
			<command idQ="rResetPositionSideBySide" singlerowfold="1"/>
