		<KxCloseOtherCommand aid="85005" customTip="CloseOtherWindow" hotKey="o" icon="CloseOtherWindow" id="rCloseOtherWindow" rbHotKey="O" spaceHint="suitable" text2="@Close&#10;Other Window" text="@Close Other Windows"/>
		<KxCloseWindowCommand customTip="CloseWindow" hotKey="c" icon="close_window_kd" id="rCloseWindow" ksoCmd="CloseWindow" rbHotKey="C" spaceHint="suitable" tc="window" text="@Close Window"/>
