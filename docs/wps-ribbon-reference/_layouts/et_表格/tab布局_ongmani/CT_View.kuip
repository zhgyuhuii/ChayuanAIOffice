		<KxLegacyTriggerCommand controlType="0" customTip="NewWindow" hotKey="n" icon="window_add_kd" id="rNewWindow" idMso="WindowNew" ksoCmd="NewWindow" rbHotKey="N" spaceHint="autocompact" text="@New&#10;Window"/>
