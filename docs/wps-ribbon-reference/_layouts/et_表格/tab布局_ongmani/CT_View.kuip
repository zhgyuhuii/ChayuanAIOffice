		<KxEtReadingLayoutColorCommand aid="80012" customTip2="ReadingLayout2" customTip="ReadingLayout" dynamicSpaceHint="loose;suitable" filterFlag="1" hotKey="r" icon="reading_mode_kd" id="ReadingLayoutAndColor" ksoCmd="ReadingLayout" ksoTriggerCmd="RecentReadingLayout" needLogin="false" text="@Reading&#10;Layout">
