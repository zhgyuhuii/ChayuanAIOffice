			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="l" icon="cell_freeze_column_kd" id="rFreezeColumn" ksoCmd="FreezeColumn" text="@Freeze Column"/>
			<KxEtFreezeTableHeadCommand align="1" controlType="0" filterFlag="1" hotKey="h" icon="cell_freeze_leader_kd" id="rFreezeHead" idKey="ETFreezeTableHeadEntrance" imageTip="FreezeTableHeadTip" imageTipHeight="112" imageTipText="@Intelligent recognition and freezing of table title rows and columns based on selection criteria" imageTipWidth="214" ksoCmd="FreezeTopRow" openPosition="restab_view_freeze" showTip="true" text="@Freeze Table Head"/>
			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="r" icon="cell_freeze_top_row_kd" id="rFreezeTopRow" ksoCmd="FreezeTopRow" text="@Freeze Top Row"/>
			<KxEtFreezeTipCommand controlType="0" filterFlag="1" hotKey="c" icon="cell_freeze_top_arrange_kd" id="rFreezeFirstColumn" ksoCmd="FreezeFirstColumn" text="@Freeze First Column"/>
