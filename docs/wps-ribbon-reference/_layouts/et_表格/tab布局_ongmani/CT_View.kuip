<shell component="et" tc="et_ongmani.ct_view" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxLegacyTriggerCommand aid="723" controlType="6" customTip="NormalViewEt" filterFlag="1" hotKey="n" icon="sheet_normal_kd" id="Normal" idMso="ViewNormalViewExcel" ksoCmd="Normal" rbHotKey="L" text="@Normal"/>
		<KxLegacyTriggerCommand aid="724" controlType="6" customTip="PageBreakPreview" filterFlag="1" hotKey="p" icon="page_break_preview_kd" id="PageBreakPreview" idMso="ViewPageBreakPreviewView" ksoCmd="PageBreakPreview" rbHotKey="I" text="@Page Break &#10;Preview"/>
