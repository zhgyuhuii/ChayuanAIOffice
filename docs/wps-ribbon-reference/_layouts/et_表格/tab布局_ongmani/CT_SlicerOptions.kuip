<?xml version='1.0' encoding='UTF-8'?>
<shell component="et" tc="ongmani.ct_sliceroptions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KListCommand groupTip="SlicerOptionSlicerGroup" icon="slicer_insert_kd" id="RB_Slicer" text="@Slicer">
			<KLabelCommand fixedHeight="24" spaceHint="suitable" text="@Slicer Captions:"/>
			<KxEtLineEditCommand customTip="SlicerCaption" fixedHeight="24" fixedWidth="70" hotKey="t" ksoCmd="ChangeSlicerCaption" qtspyName="SlicerCaption" rbHotKey="T" spaceHint="suitable" text=""/>
			<KLayoutWidgetCommand fixedWidth="2"/>
			<command idQ="SlicerReportConnection"/>
			<command idQ="SlicerSetting"/>
		</KListCommand>
		<KxLegacyTriggerCommand aid="170" controlType="0" hotKey="f" icon="level_bring_forward_kd" id="BringForward" idMso="ObjectBringForward" ksoCmd="BringForward" rbHotKey="F" text="@Bring Forward"/>
		<KxLegacyTriggerCommand aid="166" controlType="0" hotKey="R" icon="level_top_kd" id="RbBringToFront" idMso="ObjectBringToFront" ksoCmd="BringToFront" text="@Bring to Front"/>
		<KxListCommand customTip2="BringForward2" customTip="BringForward" hotKey="f" icon="level_bring_forward_kd" id="Slicer_sp_BringForward" ksoCmd="BringForward" rbHotKey="AF" spaceHint="suitable" text="@MoveTo Up">
			<command idQ="BringForward"/>
			<command idQ="RbBringToFront"/>
		</KxListCommand>
		<KxLegacyTriggerCommand aid="25214" icon="slicer_move_kd" id="MoveSlicer" ksoCmd="MoveSlicer" rbHotKey="M" text="@Move Slicer"/>
		<KxLegacyTriggerCommand aid="171" controlType="0" hotKey="b" icon="level_send_backward_kd" id="SendBackward" idMso="ObjectSendBackward" ksoCmd="SendBackward" rbHotKey="B" text="@Send Backward"/>
		<KxLegacyTriggerCommand aid="167" controlType="0" hotKey="k" icon="level_bottom_kd" id="SendToBack" idMso="ObjectSendToBack" ksoCmd="SendToBack" rbHotKey="K" text="@Send to Back"/>
		<KxListCommand customTip2="SendBackward2" customTip="SendBackward" hotKey="b" icon="level_send_backward_kd" id="Slicer_sp_SendBackward" ksoCmd="SendBackward" rbHotKey="AE" spaceHint="suitable" text="@MoveTo Down">
			<command idQ="SendBackward"/>
			<command idQ="SendToBack"/>
		</KxListCommand>
		<KxValueCommand aid="664" controlType="0" hotKey="l" icon="align_draw_left_kd" id="DrawAlignLeft" idMso="ObjectsAlignLeft" index="0" ksoCmd="DrawAlign" rbHotKey="L" text="@Align Left"/>
		<KxValueCommand aid="668" controlType="0" hotKey="c" icon="align_draw_center_kd" id="DrawAlignCenter" idMso="ObjectsAlignCenterHorizontal" index="1" ksoCmd="DrawAlign" rbHotKey="C" text="@Align Center"/>
		<KxValueCommand aid="665" controlType="0" hotKey="r" icon="align_draw_right_kd" id="DrawAlignRight" idMso="ObjectsAlignRight" index="2" ksoCmd="DrawAlign" rbHotKey="R" text="@Align Right"/>
		<KxValueCommand aid="666" controlType="0" hotKey="t" icon="align_draw_top_kd" id="DrawAlignTop" idMso="ObjectsAlignTop" index="3" ksoCmd="DrawAlign" rbHotKey="T" text="@Align Top"/>
		<KxValueCommand aid="669" controlType="0" hotKey="m" icon="align_draw_vertical_kd" id="DrawAlignMiddle" idMso="ObjectsAlignMiddleVertical" index="4" ksoCmd="DrawAlign" rbHotKey="M" text="@Align Middle"/>
		<KxValueCommand aid="667" controlType="0" hotKey="b" icon="align_draw_bottom_kd" id="DrawAlignBottom" idMso="ObjectsAlignBottom" index="5" ksoCmd="DrawAlign" rbHotKey="B" text="@Align Bottom"/>
		<KxLegacyTriggerCommand aid="408" controlType="0" hotKey="h" icon="align_distribute_horizontal_kd" id="AlignDistributeHori" idMso="AlignDistributeHorizontally" ksoCmd="AlignDistributeHori" rbHotKey="H" text="@Distribute Horizontally"/>
		<KxLegacyTriggerCommand aid="465" controlType="0" hotKey="v" icon="align_distribute_vertical_kd" id="AlignDistributeVert" idMso="AlignDistributeVertically" ksoCmd="AlignDistributeVert" rbHotKey="V" text="@Distribute Vertically"/>
		<KxLegacyTriggerCommand aid="80050" hotKey="e" icon="ranks_distribute_rows_kd" id="EqualHeight" ksoCmd="EqualHeight" rbHotKey="EH" text="@Equal Height"/>
		<KxLegacyTriggerCommand aid="80051" hotKey="w" icon="ranks_distribute_columns_kd" id="EqualWidth" ksoCmd="EqualWidth" rbHotKey="EW" text="@Equal Width"/>
		<KxLegacyTriggerCommand aid="80052" hotKey="s" icon="equal_size_kd" id="EqualSize" ksoCmd="EqualSize" rbHotKey="ES" text="@Equal Size"/>
		<KxLegacyTriggerCommand aid="549" controlType="6" hotKey="P" icon="snap_to_grid_kd" id="RbSnaptoGrid" idMso="SnapToGrid" ksoCmd="SnaptoGrid" text="@Snap to Grid"/>
		<KxLegacyTriggerCommand hotKey="G" icon="grid_switch_kd" id="rShowGrid" ksoCmd="FTB_GridSwitch" text="@Show Grid"/>
		<KListCommand customTip="Align" icon="align_draw_left_kd" id="Slicer_m_Align" rbHotKey="AA" text="@Align">
			<command idQ="AlignmentControl"/>
			<command idQ="DrawAlignLeft"/>
			<command idQ="DrawAlignCenter"/>
			<command idQ="DrawAlignRight"/>
			<command idQ="DrawAlignTop"/>
			<command idQ="DrawAlignMiddle"/>
			<command idQ="DrawAlignBottom"/>
			<separator/>
			<command idQ="AlignDistributeHori"/>
			<command idQ="AlignDistributeVert"/>
			<separator/>
			<command idQ="EqualHeight"/>
			<command idQ="EqualWidth"/>
			<command idQ="EqualSize"/>
			<separator/>
			<command idQ="RbSnaptoGrid"/>
			<command idQ="rShowGrid"/>
		</KListCommand>
		<KxLegacyTriggerCommand aid="164" controlType="0" hotKey="g" icon="group_kd" id="Group" idMso="ObjectsGroup" ksoCmd="Group" rbHotKey="G" text="@Group"/>
		<KxLegacyTriggerCommand aid="165" controlType="0" hotKey="u" icon="group_cancel_kd" id="UnGroup" idMso="ObjectsUngroup" ksoCmd="UnGroup" rbHotKey="U" text="@Ungroup"/>
		<KListCommand customTip="Group" icon="group_kd" id="Slicer_m_Group" rbHotKey="AG" spaceHint="suitable" text="@Group">
			<command idQ="Group"/>
			<command idQ="UnGroup"/>
		</KListCommand>
		<KxLegacyTriggerCommand aid="199" controlType="0" hotKey="l" icon="rotate_left_kd" id="RotateLeft" idMso="ObjectRotateLeft90" ksoCmd="RotateLeft" rbHotKey="L" text="@Rotate Left 90°"/>
		<KxLegacyTriggerCommand aid="198" controlType="0" hotKey="r" icon="rotate_right_kd" id="RotateRight" idMso="ObjectRotateRight90" ksoCmd="RotateRight" rbHotKey="R" text="@Rotate Right 90°"/>
		<KxLegacyTriggerCommand aid="196" controlType="0" hotKey="h" icon="flip_horizontal_kd" id="FlipHorizontal" idMso="ObjectFlipHorizontal" ksoCmd="FlipHorizontal" rbHotKey="H" text="@Flip Horizontal"/>
		<KxLegacyTriggerCommand aid="197" controlType="0" hotKey="v" icon="flip_vertical_kd" id="FlipVertical" idMso="ObjectFlipVertical" ksoCmd="FlipVertical" rbHotKey="V" text="@Flip Vertical"/>
		<KListCommand customTip="RotateRight" icon="rotate_right_kd" id="Slicer_m_Rotate" rbHotKey="AY" spaceHint="suitable" text="@Rotate">
			<command idQ="RotateLeft"/>
			<command idQ="RotateRight"/>
			<separator/>
			<command idQ="FlipHorizontal"/>
			<command idQ="FlipVertical"/>
		</KListCommand>
		<KxListCommand customTip="FormatObjectSize" groupTip="SlicerOptionPositionSizeGroup" icon="slide_orientation_kd" id="Slicer_RB_Size" ksoCmd="FormatObjectSize" rbFileMenuEmbed="1" singlerowmergesetting="SingleRow_Slicer_RB_Size" text="@Position Size">
			<KxSingleRowMergeGroupCommand customTip="SlicerOptionPositionSizeGroup" icon="slide_orientation_kd" id="SingleRow_Slicer_RB_Size" text="@Position Size"/>
			<KxLegacyTriggerCommand aid="25214" icon="slicer_move_kd" id="MoveSlicer" ksoCmd="MoveSlicer" rbHotKey="M" singlerowmergegroup="SingleRow_Slicer_RB_Size" text="@Move Slicer"/>
			<KLayoutWidgetCommand fixedWidth="3"/>
			<KxEtHeightSpinboxCommand buttonSymbols="UpDownArrows" customTip="ShapeHeight" embedHint="1" icon="ranks_rows_height_kd" id="ShapeHeight" ksoCmd="ShapeHeight" singlerowmergegroup="SingleRow_Slicer_RB_Size" spaceHint="suitable"/>
			<KxEtWidthSpinboxCommand buttonSymbols="UpDownArrows" customTip="ShapeWidth" embedHint="1" icon="ranks_column_width_kd" id="ShapeWidth" ksoCmd="ShapeWidth" singlerowmergegroup="SingleRow_Slicer_RB_Size" spaceHint="suitable"/>
		</KxListCommand>
		<KxListCommand groupTip="SlicerOptionButtonGroup" icon="slicer_column_kd" id="Slicer_Item_RB_Size" rbFileMenuEmbed="1" text="@Buttons">
			<KxSingleRowMergeGroupCommand customTip="SlicerOptionButtonGroup" icon="slicer_column_kd" id="SingleRow_Slicer_Item_RB_Size" text="@Buttons"/>
			<KxEtSlicerColumnEditCommand buttonSymbols="UpDownArrows" customTip="SlicerColumn" embedHint="1" icon="slicer_column_kd" id="SlicerColumn" ksoCmd="SlicerColumn" singlerowmergegroup="SingleRow_Slicer_Item_RB_Size" spaceHint="suitable" text="@Column Width:"/>
			<KLayoutWidgetCommand fixedWidth="3"/>
			<KxEtSlicerHeightEditCommand buttonSymbols="UpDownArrows" customTip="SlicerItemHeight" embedHint="1" icon="ranks_rows_height_kd" id="SlicerItemHeight" ksoCmd="SlicerItemHeight" singlerowmergegroup="SingleRow_Slicer_Item_RB_Size" spaceHint="suitable"/>
			<KxEtSlicerWidthEditCommand buttonSymbols="UpDownArrows" customTip="SlicerItemWidth" embedHint="1" icon="ranks_column_width_kd" id="SlicerItemWidth" ksoCmd="SlicerItemWidth" singlerowmergegroup="SingleRow_Slicer_Item_RB_Size" spaceHint="suitable"/>
		</KxListCommand>
		<KListCommand groupTip="SlicerOptionArrangeGroup" icon="align_draw_left_kd" id="Slicer_RB_Arrange" rbFileMenuEmbed="1" text="@Arrange">
			<command idQ="Slicer_m_Align"/>
			<command idQ="Slicer_m_Group"/>
			<command idQ="Slicer_m_Rotate"/>
			<command idQ="Slicer_sp_BringForward" singlerowfoldgroup="bringsend_pair"/>
			<command idQ="Slicer_sp_SendBackward" singlerowfoldgroup="bringsend_pair"/>
			<KxObjectSelectCommand controlType="6" customTip="ObjectSelect" icon="object_select_kd" id="ObjectSelect_Slicer" idMso="SelectionPane" ksoCmd="ObjectSelect" rbHotKey="AB" text="@Selection Pane"/>
		</KListCommand>
	</commands>
	<subcommands>
		<subcommand id="CT_SlicerOptions">
			<command idQ="RB_Slicer"/>
			<separator/>
			<command idQ="SlicerStyles"/>
			<separator/>
			<command idQ="Slicer_RB_Arrange"/>
			<separator/>
			<command idQ="Slicer_Item_RB_Size"/>
			<separator/>
			<command idQ="Slicer_RB_Size"/>
			<separator/>
		</subcommand>
	</subcommands>
</shell>
