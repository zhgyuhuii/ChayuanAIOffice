<?xml version='1.0' encoding='UTF-8'?>
<shell component="et" tc="et_ongmani.ct_graphictool" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxListCommand customTip="FormatPainter" groupTip="GraphicToolFormatPainterGroup" icon="brush_kd" id="RB_FormatPicture" text="@Format Painter">
			<KxLegacyDblTriggerCommandEx customTip="FormatPainter" icon="brush_kd" id="FormatPicture" ksoCmd="FormatPainter" rbHotKey="FP" text="@Format Painter"/>
