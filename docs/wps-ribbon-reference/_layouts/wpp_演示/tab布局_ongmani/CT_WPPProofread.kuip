<?xml version='1.0' encoding='utf-8'?>
<shell component="wpp" tc="ongmani.ct_wppproofread" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KListCommand id="Proofread" rbFileMenuEmbed="1" text="@Proofread">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="doc_tick_two_kd" id="ProxyProofreadGeneralCmd" idMso="ProxyProofreadGeneralCmd" targetId="ProofreadGeneralCmd" targetModule="kproofread" text="@General Proofread"/>
		</KListCommand>
		<KListCommand id="WordDictManagement" rbFileMenuEmbed="1" text="@WordDictManagement">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="doc_add_kd" id="ProxyProofreadAddRightWordCmd" targetId="ProofreadAddRightWordCmd" targetModule="kproofread" text="@Add Right Word"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="doc_word_bank_wrong_kd" id="ProxyProofreadAddErrorWordCmd" targetId="ProofreadAddErrorWordCmd" targetModule="kproofread" text="@Add Error Word"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="doc_vocabulary_kd" id="ProxyProofreadWordDictManagementCmd" targetId="ProofreadWordDictManagementCmd" targetModule="kproofread" text="@WordDictManagement"/>
		</KListCommand>
		<KListCommand id="Assistant" rbFileMenuEmbed="1" text="@Assistant">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="customer_service_kd" id="ProxyProofreadFeedbackCmd" targetId="ProofreadFeedbackCmd" targetModule="kproofread" text="@Feedback"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="setup_kd" id="ProxyProofreadSettingCmd" targetId="ProofreadSettingCmd" targetModule="kproofread" text="@Setting"/>
		</KListCommand>
		<KListCommand id="ProofreadClose" text="@Close">
			<KxAIProofreadProxyCommand customTip="Login" delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="KLoginMenu_AccountInfo" id="ProxyProofreadLoginCmd" targetId="ProofreadLoginCmd" targetModule="kproofread" text="@Login"/>
			<KxAIProofreadProxyCommand customTip="CloseProofread" delayLoadLib="false" delayloadPath="commands/wpp/ongmani/ProxyCommands.kuip" icon="close_window_kd" id="ProxyCloseProofreadCmd" singlerowpriority="100" targetId="CloseProofreadCmd" targetModule="kproofread" text="@Exit Proofread"/>
		</KListCommand>
	</commands>
	<subcommands>
		<subcommand id="CT_Proofread">
			<command idQ="Proofread"/>
			<separator/>
			<command idQ="WordDictManagement"/>
			<separator/>
			<command idQ="Assistant"/>
			<separator/>
			<command idQ="ProofreadClose"/>
		</subcommand>
	</subcommands>
</shell>
