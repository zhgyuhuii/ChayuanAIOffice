		<KxLegacyTriggerCommand controlType="0" customTip="ClearFormats" hotKey="E" icon="eraser_kd" id="ClearFormats" idMso="ClearFormats" ksoCmd="ClearFormats" rbHotKey="E" text="@Clear Formatting"/>
		<KxListCommand customTip="RB_Font" forceVisible="1" groupTip="SmartArtFormatToolFontGroup" icon="symbol_a_kd" id="RB_SAFont" ksoCmd="Font" needsinglerowmorebutton="true" rbFileMenuEmbed="1" text="@Font">
			<KListCommand embedHint="1">
				<KRbLayoutListCommand horizontalSpacing="6" layoutOnly="1">
					<KFontRbLayoutListCommand horizontalSpacing="1" id="FontLayoutListInHomeTab" isDrawInnerBorder="1">
						<KxWppFontComboboxCommand controlType="2" customTip="FontName" horizontalPolicy="Expanding" id="FontName" ksoCmd="FontName" layoutOnLeft="true" minimumWidth="116" rbHotKey="FF" singlerowfoldgroup="font_info_pair" text="@Font" verticalPolicy="Preferred"/>
						<KxWppFontSizePreviewCommand controlType="2" customTip="FontSize" fixedWidth="60" horizontalPolicy="Preferred" id="FontSize" idMso="FontSize" ksoCmd="FontSize" layoutOnRight="true" rbHotKey="FS" singlerowfoldgroup="font_info_pair" text="@Font Size" verticalPolicy="Preferred"/>
					</KFontRbLayoutListCommand>
					<KRbLayoutListCommand bottomSpace="0" horizontalSpacing="4" layoutOnly="1" leftSpace="0" rightSpace="0" spaceHint="compact" topSpace="0">
						<command idQ="IncreaseFontSize" singlerowfoldgroup="font_size_pair"/>
						<command idQ="DecreaseFontSize" singlerowfoldgroup="font_size_pair"/>
					</KRbLayoutListCommand>
				</KRbLayoutListCommand>
				<KRbLayoutListCommand bottomSpace="0" horizontalSpacing="4" layoutOnly="1" leftSpace="0" rightSpace="0" topSpace="0">
					<command idQ="Bold" singlerowfoldgroup="format_pair"/>
					<command idQ="Italic" singlerowfoldgroup="format_pair"/>
					<command idQ="Underline" singlerowfoldgroup="format_pair"/>
