			<KxWppSALineColorCommand customTip2="ShapeLine2" customTip="ShapeLine" icon="color_border_wps_kd" id="SA_LineColor_ShapeStyle" ksoCmd="LineColor" ksoTriggerCmd="RecentLineColor" qtspyName="m_Style_LineColor_ShapeStyle" rbHotKey="SO" text="@Shape Line">
