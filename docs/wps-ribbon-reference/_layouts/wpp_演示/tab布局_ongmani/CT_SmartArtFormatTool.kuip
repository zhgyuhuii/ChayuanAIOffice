					<KRbLayoutListCommand bottomSpace="0" fixedwidgetWidth="40" horizontalSpacing="0" layoutOnly="1" leftSpace="0" rightSpace="0" topSpace="0">
						<KxWppAlignFontCommand customTip="DrawFontAlign" hotKey="n" icon="font_align_kd" id="FontAlignMenuInHomeTab" qtspyName="FontAlign" rbHotKey="AF" singlerowfold="1" text="@Align Font">
