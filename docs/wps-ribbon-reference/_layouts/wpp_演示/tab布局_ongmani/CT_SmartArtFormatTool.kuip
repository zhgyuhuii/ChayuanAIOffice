		<KxListCommand customTip="RB_Paragraph" forceVisible="1" groupTip="SmartArtFormatToolParagraphGroup" horizontalSpacing="0" icon="menu_kd" id="RB_SAParagraph" ksoCmd="Paragraph" needsinglerowmorebutton="true" rbFileMenuEmbed="1" text="@Paragraph">
			<KListCommand embedHint="1">
