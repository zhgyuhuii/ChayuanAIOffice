<?xml version='1.0' encoding='UTF-8'?>
<shell component="wpp" tc="ongmani.ct_orgchart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxLegacyTriggerCommand aid="1446" customTip="AddSubordinate" detail="@Add Subordinate" faceid="260" hotKey="b" icon="OrgChartAddSubordinate" id="OrgChartAddSubordinate" ksoCmd="OrgChartInsertSubordinate" rbHotKey="B" tc="OrgChartAndDiagram" text="@Add Subordinate"/>
		<KxLegacyTriggerCommand aid="1447" customTip="AddCoworker" detail="@Add Coworker" faceid="261" hotKey="c" icon="OrgChartAddCoworker" id="OrgChartAddCoworker" ksoCmd="OrgChartInsertCoworker" rbHotKey="W" tc="OrgChartAndDiagram" text="@Add Coworker"/>
		<KxLegacyTriggerCommand aid="1448" customTip="AddAssistant" detail="@Add Assistant" faceid="262" hotKey="a" icon="OrgChartAddAssistant" id="OrgChartAddAssistant" ksoCmd="OrgChartInsertAssistant" rbHotKey="A" tc="OrgChartAndDiagram" text="@Add Assistant"/>
		<KxLegacyTriggerCommand aid="1450" faceid="263" hotKey="s" icon="chart_standard_kd" id="OrgChartStandard" ksoCmd="OrgChartStandard" rbHotKey="S" tc="OrgChartAndDiagram" text="@Standard"/>
