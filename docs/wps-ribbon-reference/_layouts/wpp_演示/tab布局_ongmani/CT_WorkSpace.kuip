		<KAutoHideListCommand icon="handy_tool_kd" id="RB_CommonCmd_ConvenienceTools" text="@RB_CommonCmd_ConvenienceTools_text" tipContent="@RB_CommonCmd_ConvenienceTools_tipContent" tipTitle="@RB_CommonCmd_ConvenienceTools_tipTitle">
			<KAppCommand appCmdObj="BatchCompress" appId="kdocumentslimming" customTip="DocumentSlimming" dialogHint="1" hotKey="V" icon="file_compression_kd" id="DocumentSlimmingTab" idKey="AIMemberShipTabEntry" idMso="DocumentSlimming" needLogin="false" qtspyName="DocumentSlimmingTab" rbHotKey="V" text="@Document Slimming"/>
		</KAutoHideListCommand>
		<KAutoHideListCommand id="RB_MoreApp" text="@More App">
			<KAppCommand appCmdObj="AppStore" appId="kappstore" icon="more_two_kd" id="more_app" needLogin="false" text="@More App"/>
		</KAutoHideListCommand>
	</commands>
	<subcommands>
