			<KxLegacyTriggerCommand customTip="InsertWordArt" detail="@WordArt@Insert" hotKey="w" icon="font_art_style_kd" id="InsertWordArtInWordArtTab" ksoCmd="InsertWordArt" qtspyName="InsertWordArt" rbHotKey="W" text="@WordArt@Insert"/>
		</KListCommand>
		<KListCommand id="WA_ShadowAnd3D">
			<KxLegacyTriggerCommand customTip="ShadowOnOff" icon="shadow_setup_kd" id="WA_ShadowOnOff" ksoCmd="ShadowOnOff" rbHotKey="z" spaceHint="suitable" text="@Shadow On"/>
			<KxLegacyTriggerCommand customTip="3DOnOff" icon="com_addin_kd" id="WA_3DOnOff" ksoCmd="3DOnOff" rbHotKey="y" spaceHint="suitable" text2="@3-D&#10;On" text="@3-D On"/>
		</KListCommand>
	</commands>
	<subcommands>
		<subcommand id="CT_WordArt">
			<command idQ="RB_DC_InsertWordArt"/>
			<separator/>
			<command idQ="RB_WordArt"/>
