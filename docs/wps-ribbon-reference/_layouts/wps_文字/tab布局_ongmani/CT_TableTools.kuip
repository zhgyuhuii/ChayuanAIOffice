				<KxValueCommand customTip="CellAlignHCenter" icon="align_center_kd" id="TableToolsAlignHCenter" index="1" ksoCmd="TableCellAlignHorizontal" rbHotKey="AC" singlerowmergegroup="SingleRow_Alignment_Left" text="@Align HCenter"/>
				<KxValueCommand customTip="CellAlignRight" icon="align_right_kd" id="TableToolsAlignRight" index="2" ksoCmd="TableCellAlignHorizontal" rbHotKey="AR" singlerowmergegroup="SingleRow_Alignment_Left" text="@Align Right"/>
			</KRbLayoutListCommand>
			<command idQ="m_TableTextDirection"/>
		</KListCommand>
		<KListCommand id="DetailedSettings_TableTool" text="@Settings">
			<KListCommand customTip="DetailedSettings_TableTool" icon="detailed_settings_kd" id="DetailedSettingsList_TableTool" qtspyName="DetailedSettings" text="@Settings">
				<command idQ="TableProperties"/>
				<KxLegacyTriggerCommand dialogHint="1" hotKey="f" icon="ranks_add_left_kd" id="InsertCells_TableTool" ksoCmd="InsertCells" qtspyName="InsertCells" text="@Rows and Columns"/>
				<KxLegacyTriggerCommand dialogHint="1" hotKey="f" icon="symbol_a_kd" id="Font_TableTool" ksoCmd="Font" qtspyName="Font" text="@Font"/>
			</KListCommand>
		</KListCommand>
	</commands>
	<subcommands>
