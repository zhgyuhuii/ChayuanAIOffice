			<command idQ="TableSelectMenu"/>
			<separator idKey="LogicGroupShowExtensionButton"/>
			<command idKey="LogicGroupShowExtensionButton" idQ="DetailedSettings_TableTool"/>
		</subcommand>
	</subcommands>
</shell>
