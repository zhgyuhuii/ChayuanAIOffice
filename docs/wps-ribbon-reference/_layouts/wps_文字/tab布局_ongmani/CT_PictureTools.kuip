				<KAppCommand action="photobatchcorrecting" appCmdObj="PictureBatchProcess" appId="photonewbatchapp" entrance="Ribbon_PicToolTab" icon="batch_pic_correction_kd" id="app_photonewbatchapp_picturetools_correcting" text="@Correct"/>
				<KAppCommand action="photobatchrotate" appCmdObj="PictureBatchProcess" appId="photonewbatchapp" entrance="Ribbon_PicToolTab" icon="batch_rotation_kd" id="app_photonewbatchapp_picturetools_rotation" text="@Rotate"/>
			</KAutoHideTilingCommand>
			<KAutoHideTilingCommand appFlags="wpsmember" text="@batch edit">
				<KAppPhotoAiControlCommand action="photobatchmatting" aiControlName="app/photomattingapp" appCmdObj="PictureBatchProcess" appId="photonewbatchapp" entrance="Ribbon_PicToolTab" icon="select_cutout_kd" id="app_photonewbatchapp_picturetools_matting" text="@Cutout"/>
				<KAppCommand action="photobatchtext" appCmdObj="PictureBatchProcess" appId="photonewbatchapp" entrance="Ribbon_PicToolTab" icon="watermark_batch_kd" id="app_photonewbatchapp_picturetools_text_watermark" text="@Add Text Watermark"/>
				<KAppCommand action="photobatchwatermark" appCmdObj="PictureBatchProcess" appId="photonewbatchapp" entrance="Ribbon_PicToolTab" icon="watermark_batch_kd" id="app_photonewbatchapp_picturetools_pic_watermark" text="@Add Image Watermark"/>
				<KAppCommand appCmdObj="PictureBatchProcess" appId="photospliceapp" entrance="Ribbon_PicToolTab" icon="shape_three_kd" id="app_photospliceapp" text="@Photo Splicing"/>
			</KAutoHideTilingCommand>
		</KAutoHideTilingListCommand>
		<KAppCommand appCmdObj="PhotoExchange" appId="photoprintapp" customTip="PhotoPrint" entrance="Ribbon_PicToolTab" icon="print_kd" id="app_photoprintapp" spaceHint="suitable" text="@Print"/>
		<KAutoHideListCommand groupTip="PictureToolAdvancedFeatureGroup" icon="shape_four_kd" id="RB_AdvancedPictureTool" idKey="PhotoNewRibbonLayout" text="@Advanced Picture Tool">
