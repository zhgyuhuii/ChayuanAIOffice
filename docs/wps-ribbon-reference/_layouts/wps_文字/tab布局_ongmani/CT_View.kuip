				<KxVertTileCommand controlType="6" hotKey="V" icon="window_vert_tile_kd" id="VerticalTileInViewTab" idMso="WindowsVertical" qtspyName="VerticalTile" text="@Vertical"/>
				<KxCascadeCommand controlType="6" hotKey="C" icon="cascade_kd" id="CascadeInViewTab" idMso="WindowsCascade" qtspyName="Cascade" text="@Cascade"/>
