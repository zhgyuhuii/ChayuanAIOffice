			<KxTaskPaneCheckBoxCommand controlType="1" customTip="TaskPane" hotKey="t" id="TaskPaneInViewTab" idMso="ViewTaskWindow" ksoCmd="TaskPane" qtspyName="TaskPane" rbHotKey="K" singlerowfold="1" spaceHint="suitable" text="@Task Window"/>
			<KxCheckBoxCommand controlType="1" customTip="Gridlines" hotKey="g" id="ViewGridlinesWord" idMso="ViewGridlinesWord" ksoCmd="Gridlines" qtspyName="Gridlines" rbHotKey="G" singlerowfold="1" spaceHint="suitable" text="@View Gridlines"/>
