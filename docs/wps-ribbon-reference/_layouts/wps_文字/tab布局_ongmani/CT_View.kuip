		<KxLegacyTriggerCommand controlType="0" customTip="Zoom" icon="screen_zoom_kd" id="ZoomToolBar" idMso="ZoomDialog" ksoCmd="Zoom" needLogin="false" rbHotKey="Q" text="@Zoom"/>
