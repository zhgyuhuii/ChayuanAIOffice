			<command idQ="ZoomToolBar" singlerowmergegroup="SingleRow_Zoom"/>
			<command idQ="100%" singlerowmergegroup="SingleRow_Zoom"/>
			<KxValueCommand controlType="0" customTip="PageWidth" icon="page_width_kd" id="ZoomPageWidth" idMso="ZoomPageWidth" index="-1" ksoCmd="ZoomCombo" needLogin="false" qtspyName="ZoomPageWidth" rbHotKey="I" singlerowmergegroup="SingleRow_Zoom" spaceHint="suitable" text="@Page Width"/>
