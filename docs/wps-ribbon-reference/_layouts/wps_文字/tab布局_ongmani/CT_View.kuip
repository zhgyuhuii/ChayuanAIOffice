		</KListCommand>
		<KxLegacyTriggerCommand aid="80011" controlType="6" hotKey="e" id="DocumentMapLeft" idMso="NavigationPanePlaceOnLeft" ksoCmd="DocumentMapLeft" text="@Place on Left"/>
		<KxLegacyTriggerCommand aid="80012" controlType="6" hotKey="r" id="DocumentMapRight" idMso="NavigationPanePlaceOnRight" ksoCmd="DocumentMapRight" text="@Place on Right"/>
		<KxLegacyTriggerCommand aid="80013" controlType="6" hotKey="v" id="DocumentMapVisible" idMso="NavigationPaneInvisible" ksoCmd="DocumentMapVisible" text="@Invisible"/>
		<KxLegacyTriggerCommand controlType="6" customTip="DocFieldTree" icon="document_field_tree_kd" id="OfficialModeDocFieldTree" idKey="WPSOfficialModeDocFieldTree" ksoCmd="DocumentFieldView" qtspyName="DocFieldTree" text="@Document SemanticsTree"/>
		<KxListCommand controlType="5" customTip2="ShowNavigationPane2" customTip="ShowNavigationPane" detail="@Show Document Map" hotKey="d" icon="navigation_pane_kd" id="sp_ShowDocumentMap" idMso="NavigationPaneShowHide" ksoCmd="ShowDocumentMap" rbHotKey="D" text="@Navigation&#10;Pane">
			<command idQ="DocumentMapLeft"/>
