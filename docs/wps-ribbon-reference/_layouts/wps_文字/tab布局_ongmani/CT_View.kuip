<?xml version='1.0' encoding='UTF-8'?>
<shell component="wps" tc="wps_ongmani.ct_view" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxWpsPrintLayoutViewCommand aid="287" controlType="6" customTip="PrintLayoutView" hotKey="g" icon="print_layout_kd" id="PrintLayoutView" idMso="ViewPrintLayoutView" ksoCmd="PrintLayoutView" rbHotKey="P" text="@Print &#10;Layout"/>
