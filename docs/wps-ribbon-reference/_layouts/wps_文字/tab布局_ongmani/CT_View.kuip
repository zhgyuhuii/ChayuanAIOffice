		<KListCommand filter="support:ShieldMode=false" groupTip="CompareGroup" icon="ne_abreast_display_kd" id="RB_View_Compare" rbFileMenuEmbed="1" text="@Compare">
			<command idQ="CmpSideBySideRibbon"/>
			<command idQ="LockSideBySide"/>
			<command idQ="VerbSideBySide"/>
		</KListCommand>
		<KListCommand id="RB_Switch" rbFileMenuEmbed="1" text="@Compare">
			<KComposeListCommand customTip="SwitchWindow" icon="window_switch_kd" id="rSwitchWindow" rbHotKey="W" text="@Switch&#10;Window">
				<compose idQ="CurrentFileListInView"/>
