			<KxWpsPrintLayoutViewCommand aid="287" controlType="6" customTip="PrintLayoutView" hotKey="g" icon="print_layout_kd" id="RB_ViewPrintLayoutView" idMso="ViewPrintLayoutView" ksoCmd="PrintLayoutView" needLogin="false" qtspyName="PrintLayoutView" rbHotKey="P" shortcutHint="Command+Option+G" singlerowmergegroup="SingleRow_DocumentView" text="@Print &#10;Layout"/>
