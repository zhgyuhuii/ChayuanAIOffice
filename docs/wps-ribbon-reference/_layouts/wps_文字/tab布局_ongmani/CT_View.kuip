		<KxLegacyTriggerCommand aid="4387" controlType="6" customTip="OutLine" hotKey="o" icon="doc_catalog_kd" id="OutLine" idMso="ViewOutlineView" ksoCmd="OutLine" rbHotKey="U" text="@Outline"/>
		<KxLegacyTriggerCommand controlType="6" customTip="WebLayoutView" hotKey="w" icon="earth_kd" id="WebLayoutView" idMso="ViewOutlineView" ksoCmd="WebLayoutView" rbHotKey="L" text="@Web Layout"/>
