		<KxLegacyTriggerCommand aid="303" controlType="0" customTip="NewWindow" hotKey="n" icon="window_add_kd" id="rNewWindow" idMso="WindowNew" ksoCmd="NewWindow" rbHotKey="N" spaceHint="suitable" text="@New&#10;Window"/>
		<KxWpsLockSideBySideCommand controlType="6" customTip="LockSideBySide" icon="rolling_sync_kd" id="LockSideBySide" idKey="CommonWindowArrangeAllAndCompare" idMso="WindowSideBySideSynchronousScrolling" rbHotKey="VS" spaceHint="suitable" text="@Synchronous Scrolling"/>
		<KxWpsVerbSideBySideCommand controlType="6" customTip="VerbSideBySide" icon="reset_position_kd" id="VerbSideBySide" idKey="CommonWindowArrangeAllAndCompare" idMso="WindowResetPosition" rbHotKey="T" spaceHint="suitable" text="@Reset Window Position"/>
