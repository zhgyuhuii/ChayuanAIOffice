			<KListCommand controlType="5" customTip="ArrangeAll" icon="window_reset_kd" id="WindowsArrangeAll" idKey="WindowsArrangeAll" idMso="WindowsArrangeAll" qtspyName="WindowReset" rbHotKey="A" singlerowmergegroup="SingleRow_NewWindow" text="@Arrange&#10;All">
