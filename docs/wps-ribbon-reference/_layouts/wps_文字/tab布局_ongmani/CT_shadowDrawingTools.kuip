		<KListCommand groupTip="ShadowDrawingToolShadowEffectGroup" icon="shadow_style_kd" id="RB_ShadowSettings" rbFileMenuEmbed="1" text="@Shadow &#10;Effects">
			<command idQ="ShadowOnOff"/>
			<KxShadowStaticGalleryCommand column="4" customTip="ShadowPalette" icon="shadow_style_kd" id="ShadowStyleMenuInShadowToolTab" ksoCmd="ShadowPalette" qtspyName="ShadowPalette" rbHotKey="SS" text="@Shadow&#10;Effects">
				<command idQ="NoShadow"/>
