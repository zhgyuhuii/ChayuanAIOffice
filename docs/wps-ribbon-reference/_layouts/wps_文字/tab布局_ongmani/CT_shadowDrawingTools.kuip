		<KxLegacyTriggerCommand hotKey="s" id="SemitransparentShadow" ksoCmd="SemitransparentShadow" text="@Semitransparent Shadow"/>
		<KxWpsShadowColorCommand customTip2="ShadowColor2" customTip="ShadowColor" icon="shadow_color_kd" id="ShadowColor" ksoCmd="ShadowColor" ksoTriggerCmd="RecentShadowColor" rbHotKey="SC" text="@Shadow&#10;Color">
			<command idQ="MoreShadowColors"/>
			<command idQ="SnapShadowColors"/>
			<command idQ="SemitransparentShadow"/>
		</KxWpsShadowColorCommand>
		<KRbDonotShowHotKeyCommand id="NULL" rbHotKey="" spaceHint="compact"/>
