<?xml version='1.0' encoding='utf-8'?>
<shell component="pdf" tc="ongmani.ct_proofread" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<commands>
		<KxLegacyTriggerCommand customTip="MenuHandTool" icon="gesture_drag_kd" id="Proofread_HandTool" ksoCmd="HandTool" shellEntryType="tab_messauretool" shortcutHint="Ctrl+H" spaceHint="autocompact" text="@MenuHandTool"/>
		<KxLegacyTriggerCommand customTip="MenuSelectionTool" icon="mouse_kd" id="Proofread_SelectTool" ksoCmd="SelectionTool" shellEntryType="tab_messauretool" shortcutHint="Ctrl+R" spaceHint="autocompact" text="@MenuSelectionTool"/>
		<KListCommand id="RB_MouseTool_Proofread" rbFileMenuEmbed="1" text="@tool">
			<command idQ="Proofread_HandTool"/>
			<command idQ="Proofread_SelectTool"/>
		</KListCommand>
		<KListCommand id="Proofread" rbFileMenuEmbed="1" text="@proofread">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="doc_tick_two_kd" id="ProxyProofreadGeneralCmd" idMso="ProxyProofreadGeneralCmd" targetId="ProofreadGeneralCmd" targetModule="kproofread" text="@General Proofread"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="doc_tick_two_kd" id="ProxyProofreadAICmd" idMso="ProxyProofreadAICmd" targetId="ProofreadAICmd" targetModule="kproofread" text="@AI Proofread"/>
			<KxProofreadAppCommand action="EnglishProofread" appId="kproofread" args="AutoSwitchTab:true" customTip="EnglishProofread" icon="proofread_english_kd" id="ProofreadEnglishAppCommandInQuickMenu" idKey="ProofreadEnglish" idMso="ProofreadEnglishAppCommandInQuickMenu" text="@English Proofread"/>
		</KListCommand>
		<KListCommand id="WordDictManagement" rbFileMenuEmbed="1" text="@proofreadWordManagement">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="doc_add_kd" id="ProxyProofreadAddRightWordCmd" targetId="ProofreadAddRightWordCmd" targetModule="kproofread" text="@Add Right Word"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="doc_word_bank_wrong_kd" id="ProxyProofreadAddErrorWordCmd" targetId="ProofreadAddErrorWordCmd" targetModule="kproofread" text="@Add Error Word"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="doc_vocabulary_kd" id="ProxyProofreadWordDictManagementCmd" targetId="ProofreadWordDictManagementCmd" targetModule="kproofread" text="@WordDictManagement"/>
		</KListCommand>
		<KListCommand id="Assistant" rbFileMenuEmbed="1" text="@assistant">
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="customer_service_kd" id="ProxyProofreadFeedbackCmd" targetId="ProofreadFeedbackCmd" targetModule="kproofread" text="@Feedback"/>
			<KxAIProofreadProxyCommand delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="setup_kd" id="ProxyProofreadSettingCmd" targetId="ProofreadSettingCmd" targetModule="kproofread" text="@Setting"/>
		</KListCommand>
		<KListCommand id="ProofreadClose" text="@close">
			<KxAIProofreadProxyCommand customTip="Login" delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="KLoginMenu_AccountInfo" id="ProxyProofreadLoginCmd" targetId="ProofreadLoginCmd" targetModule="kproofread" text="@Login"/>
			<KxAIProofreadProxyCommand customTip="CloseProofread" delayLoadLib="false" delayloadPath="commands/pdf/ongmani/ProxyCommands.kuip" icon="close_window_kd" id="ProxyCloseProofreadCmd" targetId="CloseProofreadCmd" targetModule="kproofread" text="@Exit Proofread"/>
		</KListCommand>
	</commands>
	<subcommands>
		<subcommand id="CT_Proofread">
			<command idQ="RB_MouseTool_Proofread"/>
			<separator/>
			<command idQ="Proofread"/>
			<separator/>
			<command idQ="WordDictManagement"/>
			<separator/>
			<command idQ="Assistant"/>
			<separator/>
			<command idQ="ProofreadClose"/>
		</subcommand>
	</subcommands>
</shell>
