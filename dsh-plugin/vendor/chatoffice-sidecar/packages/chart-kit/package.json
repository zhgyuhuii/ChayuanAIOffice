{
  "name": "@chatoffice/chart-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared chart designer core: ChartSpec contract (UI/double-click/LLM), Worker sandbox for option code, ECharts example library harvester",
  "exports": {
    ".": "./src/index.ts",
    "./spec": "./src/spec/chartspec.ts",
    "./sandbox": "./src/sandbox/runner.ts",
    "./examples": "./src/examples/library.ts",
    "./mount": "./src/render/mount.ts",
    "./designer": "./src/designer/ChartDesignerModal.tsx",
    "./data-table": "./src/spec/data-table.ts",
    "./serialize": "./src/sandbox/serialize.ts",
    "./snapshot": "./src/designer/snapshot.ts",
    "./revive": "./src/render/revive.ts",
    "./error-boundary": "./src/designer/ChartErrorBoundary.tsx",
    "./echarts-global": "./src/render/echarts-global.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harvest": "node --import tsx scripts/harvest.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "echarts-gl": "2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.12",
    "jsdom": "^28.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
