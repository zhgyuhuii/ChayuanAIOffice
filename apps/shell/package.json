{
  "name": "@chaoffice/shell",
  "productName": "ChaAI Office",
  "version": "1.0.6",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhgyuhuii/ChayuanAIOffice",
  "private": true,
  "description": "Unified ChaOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "chaoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@chaoffice/agent-core": "*",
    "@chaoffice/ai-provider": "*",
    "@chaoffice/ai-search": "*",
    "@chaoffice/cli": "*",
    "@chaoffice/docs": "*",
    "@chaoffice/docx-engine": "*",
    "@chaoffice/electron-utils": "*",
    "@chaoffice/i18n": "*",
    "@chaoffice/pipelines": "*",
    "@chaoffice/pptx-engine": "*",
    "@chaoffice/pptx-render": "*",
    "@chaoffice/project-store": "*",
    "@chaoffice/sheets": "*",
    "@chaoffice/slides": "*",
    "@chaoffice/storage-adapter": "*",
    "@chaoffice/ui": "*",
    "@chaoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ChaOffice",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "chatofficeUpstreamVersion": "0.11.829"
}
