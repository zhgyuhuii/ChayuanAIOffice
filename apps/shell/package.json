{
  "name": "@chatoffice/shell",
  "productName": "ChaAI Office",
  "version": "1.0.3",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zhgyuhuii/ChayuanAIOffice",
  "private": true,
  "description": "Unified ChatOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "chaoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@chatoffice/agent-core": "*",
    "@chatoffice/ai-provider": "*",
    "@chatoffice/ai-search": "*",
    "@chatoffice/cli": "*",
    "@chatoffice/docs": "*",
    "@chatoffice/docx-engine": "*",
    "@chatoffice/electron-utils": "*",
    "@chatoffice/i18n": "*",
    "@chatoffice/pipelines": "*",
    "@chatoffice/pptx-engine": "*",
    "@chatoffice/pptx-render": "*",
    "@chatoffice/sheets": "*",
    "@chatoffice/slides": "*",
    "@chatoffice/storage-adapter": "*",
    "@chatoffice/ui": "*",
    "@chatoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ChatOffice",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "chatofficeUpstreamVersion": "0.10.1038"
}
