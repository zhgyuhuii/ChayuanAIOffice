{
  "name": "@chatoffice/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "ChatOffice BFF: hosts service-core over HTTP/WS for the web app (SaaS and embedded sidecar share this code)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --import tsx --import ./src/tsx-assets.cjs src/main.ts",
    "start": "node --import tsx --import ./src/tsx-assets.cjs src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chatoffice/ai-provider": "*",
    "@chatoffice/ai-search": "*",
    "@chatoffice/electron-utils": "*",
    "@chatoffice/pptx-engine": "*",
    "@chatoffice/pptx-render": "*",
    "@chatoffice/service-core": "*",
    "@chatoffice/storage-adapter": "*",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
